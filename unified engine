        rho_material = self.Omega_material_0 * (1.0 + redshift) ** effective_exponent
        
        # Step 2: Background Substrate response directly from the Material State
        g_vortex = alpha_dynamic * rho_material
        rho_fluid = self.Omega_fluid_0 * (1.0 + redshift) ** xi_dynamic * (1.0 + g_vortex)
        
        # Step 3: Inject Options 3 & 4 (Vacuum Micro-Creation and Spin Friction)
        # Quantum Vacuum Generation Pressure (Negative pressure opposes ultimate collapse)
        p_generation = - (self.creation_efficiency * rho_fluid * (1.0 + redshift)) / 3.0
        
        # Gravitational Churning & Twisting Vorticity Term (Centrifugal expansion assistance)
        vorticity_shear = self.omega_vorticity_0 * (1.0 + redshift) ** 2
        
        # System Synthesis (Total energetic density of the soup)
        rho_total = rho_material + rho_fluid + np.abs(p_generation)
        
        # Apply the Non-Singular Phase Rebound factor
        rebound_factor = self.calculate_phase_rebound(rho_total)
        
        # Core Expansion Engine: Combines density, vorticity boost, and the rebound limit
        hubble_pure = (rho_total + 2.0 * vorticity_shear) * rebound_factor
        
        return max(hubble_pure, 0.0)

