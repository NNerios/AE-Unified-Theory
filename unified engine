        # 🎯 3. Explicit Downstream Conversion Scalars (km/s/Mpc Mapping)
        # This baseline anchors the fluid frequency scale to the physical universe at z=0
        self.H0_km_s_Mpc = 67.4  

    def calculate_phase_rebound(self, rho_total):
        """Pure Fluid Constraint: Absolute mechanical wall prevention"""
        if rho_total >= self.rho_max:
            return 0.0
        return 1.0 - (rho_total / self.rho_max) ** 2

    def compute_raw_fluid_density_and_frequency(self, redshift):
        """
        STAGE 1: Pure Fluid Calculations.
        Calculates independent mass-densities and pure scale factor frequency.
        This layer has ZERO knowledge of traditional Lambda-CDM parameters.
        """
        xi_macro = np.log(1.0 + redshift)
        alpha_dynamic = self.alpha_0 * (1.0 + xi_macro * 0.02)
        xi_dynamic = self.xi_vacuum * (1.0 + xi_macro * 0.01)
        
        # Material Mix tracking across lookback time
        effective_exponent = 3.0 + (self.Omega_gamma / self.Omega_material_0) - alpha_dynamic
        rho_material = self.Omega_material_0 * (1.0 + redshift) ** effective_exponent
        
        # Background Substrate response via outgassing feedback
        g_vortex = alpha_dynamic * rho_material
        rho_fluid = self.Omega_fluid_0 * (1.0 + redshift) ** xi_dynamic * (1.0 + g_vortex)
        
        # Quantum Vacuum Generation Pressure
        p_generation = - (self.creation_efficiency * rho_fluid * (1.0 + redshift)) / 3.0
        
        # Gravitational Churning & Twisting Vorticity
        vorticity_shear = self.omega_vorticity_0 * (1.0 + redshift) ** 2
        if redshift > 5000.0:
            thermal_evaporation_rate = 1.0 + np.log10(redshift / 5000.0)
            vorticity_shear *= thermal_evaporation_rate
        
        # Total fluid energy density of the soup
        rho_total = rho_material + rho_fluid + np.abs(p_generation)
        rebound_factor = self.calculate_phase_rebound(rho_total)
        
        # Calculate raw bounded fluid frequency squared
        f_sub_squared = (rho_total + 2.0 * vorticity_shear) * rebound_factor
        
        return rho_material, rho_fluid, vorticity_shear, max(f_sub_squared, 0.0)

    def convert_to_astrophysical_hubble(self, raw_f_sub_squared):
        """
        STAGE 2: Explicit Downstream Conversion.
        Takes the raw independent fluid output and translates it into standard 
        astrophysical coordinates (km/s/Mpc) for external peer review.
        """
        # H(z) = H0 * sqrt(raw_f_sub_squared)
        # This isolates the conversion math so reviewers can audit the calculation steps directly.
        hubble_translated = self.H0_km_s_Mpc * np.sqrt(raw_f_sub_squared)
        return hubble_translated

