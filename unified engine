        """
        if rho_total >= self.rho_max:
            return 0.0
        # Rebound damping factor that scales down smoothly to zero at absolute compression limit
        return 1.0 - (rho_total / self.rho_max) ** 2

    def compute_hubble_squared(self, redshift):
        """
        Calculates global expansion via an advanced fluid loop with particle creation and vorticity.
        """
        xi_macro = np.log(1.0 + redshift)
        alpha_dynamic = self.alpha_0 * (1.0 + xi_macro * 0.02)
        xi_dynamic = self.xi_vacuum * (1.0 + xi_macro * 0.01)
        
        # Step 1: Material Mix tracking across lookback time
